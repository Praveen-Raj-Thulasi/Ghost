// .env.example
# Server configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/repo-seance
CLIENT_ORIGIN=http://localhost:5173

# AI configuration
AI_ENABLED=false
AI_PROVIDER=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
AI_TIMEOUT_MS=30000

# Analysis limits
MAX_COMMITS=1000
MAX_REPOSITORY_SIZE_MB=200
ANALYSIS_CONCURRENCY=1
